<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:KTexturePacker.Pages"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="KTexturePacker.Pages.PackerPage"
             Title="Packer">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="300,*">
        <!-- 工具栏 -->
        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" Padding="10">
            <Button Text="Add Images" Clicked="OnAddImagesClicked" />
            <Button Text="Add Folder" Clicked="OnAddFolderClicked" />
            <Button Text="Clear" Clicked="OnClearClicked" />
            <Button Text="Pack" Clicked="OnPackClicked" BackgroundColor="#512BD4" TextColor="White" />
            <Button Text="Export" Clicked="OnExportClicked" BackgroundColor="#2b7a2b" TextColor="White" />
        </HorizontalStackLayout>

        <!-- 左侧：精灵列表 -->
        <Border Grid.Row="1" Grid.Column="0" Stroke="#444" Padding="4">
            <CollectionView x:Name="SpriteList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto">
                            <Image Grid.RowSpan="2" Source="{Binding Thumbnail}" WidthRequest="48" HeightRequest="48" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding SizeText}" TextColor="Gray" FontSize="12" />
                            <Button Grid.Column="2" Grid.RowSpan="2" Text="&#x2715;" Clicked="OnRemoveClicked"
                                    CommandParameter="{Binding .}" BackgroundColor="#a33" TextColor="White" WidthRequest="36" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No sprites yet. Use 'Add Images' or 'Add Folder'."
                           Padding="20" TextColor="Gray" HorizontalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <!-- 右侧：参数 + 预览 -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" Padding="10" RowSpacing="8">
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Max Atlas Size" VerticalOptions="Center" />
                    <Picker x:Name="MaxSizePicker" Grid.Column="1">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>512</x:String>
                                <x:String>1024</x:String>
                                <x:String>2048</x:String>
                                <x:String>4096</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                        <Picker.SelectedIndex>2</Picker.SelectedIndex>
                    </Picker>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Padding (px)" VerticalOptions="Center" />
                    <Entry x:Name="PaddingEntry" Grid.Column="1" Keyboard="Numeric" Text="1" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Allow Rotation" VerticalOptions="Center" />
                    <Switch x:Name="AllowRotationSwitch" Grid.Column="1" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Export Format" VerticalOptions="Center" />
                    <Picker x:Name="FormatPicker" Grid.Column="1">
                        <Picker.Items>
                            <x:String>JSON (generic)</x:String>
                            <x:String>libGDX .atlas</x:String>
                        </Picker.Items>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                    </Picker>
                </Grid>
            </VerticalStackLayout>

            <Border Grid.Row="1" Stroke="#444" BackgroundColor="#1b1b1f">
                <skia:SKCanvasView x:Name="AtlasCanvas" PaintSurface="AtlasCanvas_PaintSurface" />
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Label x:Name="StatusLabel" Grid.Row="2" Grid.ColumnSpan="2" Padding="10,6"
               Text="Ready." BackgroundColor="#222" TextColor="LightGray" />
    </Grid>
</ContentPage>
