<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1：Unity（2021.2+ 原生支持）与 MonoGame 均可直接引用，且 System.Numerics.Vector2 可用。 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>KTexturePacker.Parser</RootNamespace>
    <AssemblyName>KTexturePacker.Parser</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 零依赖：不引用 System.Text.Json / Newtonsoft，使用内置的轻量 JSON 读取器。
       产出的 KTexturePacker.Parser.dll 不含任何外部程序集引用，Unity 可直接使用。 -->

</Project>
