<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>
  
  <!-- System.Text.Json 在 netstandard2.0 下通过 NuGet 提供，Unity（含 IL2CPP/AOT）与 MonoGame 均可直接引用。
       这里只用 JsonDocument / Utf8JsonReader 的 DOM 读取（无反射反序列化），因此在 AOT 环境下也安全。 -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
